# Copy to .env later if Track C needs API keys. Never commit real keys.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
# PostgreSQL (Track B). Pick your own user and password in .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=honeypot

# Grafana (Track C). Dashboard login is admin / GRAFANA_ADMIN_PASSWORD.
# GRAFANA_DB_PASSWORD is the password of the read-only database user grafana_ro.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Phone alerts (Grafana -> Discord and/or Telegram when an attack starts).
# Fill in ONE of the two; leave the other empty. Never commit real values.
# Discord: channel settings -> Integrations -> Webhooks -> copy the URL.
DISCORD_WEBHOOK_URL=
# Telegram: create a bot with @BotFather (gives the token), send it a message,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
