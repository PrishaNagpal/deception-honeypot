# Copy to .env later if Track C needs API keys. Never commit real keys.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
# PostgreSQL (Track B). Pick your own user and password in .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Grafana (Track C). Dashboard login is admin / GRAFANA_ADMIN_PASSWORD.
# GRAFANA_DB_PASSWORD is the password of the read-only database user grafana_ro.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
