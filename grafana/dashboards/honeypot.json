{
  "uid": "honeypot-live",
  "title": "Honeypot - Live Attacks",
  "tags": [
    "honeypot"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Attacks over time (events per minute)",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeypot-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeypot-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, '1m'),\n  service AS metric,\n  count(*) AS value\nFROM events\nWHERE $__timeFilter(event_time)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Top passwords tried (all honeypots)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeypot-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "password",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeypot-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT password, count(*) AS tries\nFROM events\nWHERE $__timeFilter(event_time)\n  AND password IS NOT NULL AND password <> ''\nGROUP BY password\nORDER BY tries DESC\nLIMIT 10"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top commands (Cowrie shell + FTP)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeypot-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeypot-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT command, service, count(*) AS times\nFROM events\nWHERE $__timeFilter(event_time)\n  AND event_type IN ('cowrie.command.input', 'ftp.command')\n  AND command IS NOT NULL\nGROUP BY command, service\nORDER BY times DESC\nLIMIT 10"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Live attack feed (latest 20)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeypot-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeypot-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  event_time AS \"time\",\n  service,\n  event_type,\n  host(src_ip) AS src_ip,\n  username,\n  password,\n  command\nFROM events\nORDER BY event_time DESC\nLIMIT 20"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Captured files (VirusTotal)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "honeypot-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "malicious"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "honeypot-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  first_seen AS \"first seen\",\n  service,\n  left(sha256, 16) || '...' AS sha256,\n  file_path,\n  file_size AS bytes,\n  vt_malicious AS malicious,\n  vt_suspicious AS suspicious,\n  vt_threat_label AS label,\n  vt_checked_at AS \"checked at\"\nFROM malware_samples\nORDER BY first_seen DESC\nLIMIT 20"
        }
      ]
    }
  ]
}